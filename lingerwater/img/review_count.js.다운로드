for(let i=0;i<review_counter_sub.length;i++){let value=review_counter_sub[i].getAttribute('value');review_counter_sub[i].setAttribute('complete','true');if(review_data[value]){review_counter_sub[i].innerText=review_data[value].toString().replace(/\B(?=(\d{3})+(?!\d))/g,",")}
if(review_data[value]!=0&&review_counter_sub[i].parentElement.classList.contains('alpha_module_count_container')){review_counter_sub[i].parentElement.style.display='block'}}}})}}
alpha_review_count_update_on=!0}
setTimeout(function(){alpha_review_count_update()},250)}