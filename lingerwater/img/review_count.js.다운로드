alpha_review_count_update_on=!0;alpha_review_count_update();function alpha_review_count_update(){if(alpha_review_count_update_on){alpha_review_count_update_on=!1;let review_counter=$('.alpha_module_count:not([complete="true"])')
if(review_counter.length>0){for(let j=0;j<review_counter.length/10;j++){let review_counter_sub=review_counter.slice(j*10,(j+1)*10)
let value_set=new Set([])
let value_array=[];for(let i=0;i<review_counter_sub.length;i++){let value=review_counter_sub[i].getAttribute('value');value_set.add(value)}
value_set.forEach(function(v){value_array.push(v)});let url_reviewCounter='https://review.alphwidget.com/api_widget/module/review/count?mall_id='+CAFE24API.MALL_ID+'&shop_no='+CAFE24API.SHOP_NO+'&product_no='+value_array.join(',')
