  triggerEventBySUA: async function (timestamp = undefined) {
    try {
      const self = this;
      const event = 'SUA';
      const metaData = {
        viewHistories: [],
      };
      if (timestamp) metaData.timestamp = timestamp;

      if (CAPP_ASYNC_METHODS.EC_PATH_ROLE == 'MEMBER_JOINRESULT') {
        self.createData(event, metaData);
      } else if (this.baseData.member_id) {
        if (!this.customerData.created_date) return;

        const createdDate = new Date(this.customerData.created_date);
        const now = new Date();
        const actionDelayOffset = 3 * 60 * 1000;
        const limitDate = new Date(now - actionDelayOffset);

        if (createdDate < limitDate) return;

        const SUADatas = await this.dbModule.getDatas(
          'SUA',
          (data) => {
            return data.member_id == this.baseData.member_id;
          },
          1,
        );
        if (SUADatas.length >= 1) return;

        metaData.timestamp = createdDate.getTime();
        self.createData(event, metaData);
      }
    } catch (error) {
      console.error('AlphaReview -triggerEventBySUA', error);
    }
