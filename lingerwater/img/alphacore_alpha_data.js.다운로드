    const self = this;
    const urlParams = new URLSearchParams(window.location.search);
    const urlOriginMemberId = urlParams.get('origin_member_id');
    const originMemberIdKey = self.sessionKeys.originMemberId;
    const sessionOriginMemberId = sessionStorage.getItem(originMemberIdKey);

    if (urlOriginMemberId) {
      this.baseData.origin_member_id = urlOriginMemberId;
      sessionStorage.setItem(originMemberIdKey, self.baseData.origin_member_id);
    } else if (sessionOriginMemberId) {
      this.baseData.origin_member_id = sessionOriginMemberId;
    } else {
      this.baseData.origin_member_id = '';
    }
  },
