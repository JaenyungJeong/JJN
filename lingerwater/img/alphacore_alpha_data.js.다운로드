      self.baseData.onsite_segment_id = onsiteSegmentId;
      return self.dbModule.open();
    }

    const timestamp = Date.now();
    const uuid = self.utils.makeUuid();

    // 초기화시 onsiteSegmentId 및 DB 초기화
