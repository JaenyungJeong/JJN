ALPHAREVIEW_FRONT_ALL.makenamespace = function (ns_string) {
  var parts = ns_string.split('.'),
    parent = ALPHAREVIEW_FRONT_ALL,
    i;
  // 처음에 중복되는 전역 객체명은 제거
  if (parts[0] === 'ALPHAREVIEW_FRONT_ALL') {
    parts = parts.slice(1);
  }

  for (i = 0; i < parts.length; i += 1) {
    // 프로퍼티가 존재하지 않는 경우 생성
    if (typeof parent[parts[i]] === 'undefined') {
      parent[parts[i]] = {};
    }

    parent = parent[parts[i]];
  }

  return parent;
};
