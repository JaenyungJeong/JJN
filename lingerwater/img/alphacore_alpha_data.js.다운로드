        if (err) {
          this.baseData.member_id = '';
          this.customerData = {};
          resolve(null);
        } else {
          this.baseData.member_id = res.customer.member_id ?? '';
          this.customerData = res.customer ?? {};
          resolve(res);
        }
      }),
    );
