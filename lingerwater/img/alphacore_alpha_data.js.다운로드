  triggerEventByOCV: async function () {
    try {
      if (CAPP_ASYNC_METHODS.EC_PATH_ROLE != 'ORDER_ORDERRESULT') return;

      const self = this;
      const event = 'OCV';
      const urlParams = new URLSearchParams(window.location.search);
      const orderId = urlParams.get('order_id');

      if (!orderId) return;

      await CAFE24API.getOrderDetailInfo(self.baseData.shop_no, orderId, async (err, res) => {
        if (err) {
          console.error('getOrderDetailInfo - err:', res);
        } else {
          const order = res.orders.find((order) => {
            return order.order_id === orderId;
          });

          if (!order) return;

          const items = order.items.map((item) => {
            return {
              variant_code: item.variant_code,
              product_no: item.product_no,
              product_code: item.product_code,
              product_name: item.product_name,
              product_price: self.utils.toInteger(item.product_price),
              option_price: self.utils.toInteger(item.option_price),
              additional_discount_price: self.utils.toInteger(item.additional_discount_price),
            };
          });

          const initialOrderAmount = Object.fromEntries(
            Object.entries(order.initial_order_amount).map(([key, value]) => [key, self.utils.toInteger(value)]),
          );

          const metaData = {
            order_id: orderId,
            items: items,
            ...initialOrderAmount,
          };

          self.createData(event, metaData);
        }
      });
    } catch (error) {
      console.error('AlphaReview - triggerEventByOCV', error);
    }
