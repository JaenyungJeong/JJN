ALPHAREVIEW_FRONT_ALL.makenamespace('ALPHAREVIEW_FRONT_ALL.modules.dbModule');

ALPHAREVIEW_FRONT_ALL.modules.utils = {
  toInteger: function (value) {
    if (!value) return 0;
    return parseInt(value, 10);
  },
  makeUuid: function () {
    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
      const r = (Math.random() * 16) | 0;
      const v = c === 'x' ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  },
  isValidWindow: function () {
    if (window.location.pathname.includes('protected/loginSns.html')) return false;
    return true;
  },
};
ALPHAREVIEW_FRONT_ALL.modules.dbModule = {
  dbName: 'ALPHAREVIEW_FRONT_DB',
  dbVersion: 4,
  storeTypes: ['PV', 'PRV', 'OCV', 'ONCV', 'ONCC', 'SUA'],
  db: undefined,
  delete: function () {
    const self = this;
    return new Promise((resolve, reject) => {
      const deleteRequest = indexedDB.deleteDatabase(self.dbName);

      deleteRequest.onerror = (event) => {
        console.error('AlphaReview - DB deletion error:', event.target.error);
        reject(event.target.error);
      };

      deleteRequest.onsuccess = (event) => {
        console.log(`AlphaReview - Existing DB '${self.dbName}' deleted successfully or did not exist.`);
        resolve(event.target.result);
      };
    });
  },
  open: function () {
    const self = this;
    return new Promise((resolve, reject) => {
      const request = indexedDB.open(self.dbName, this.dbVersion);
      request.onerror = (event) => {
        console.error(`AlphaReview - ${self.dbName} init error.`);
        reject(event.target.error);
      };
      request.onsuccess = (event) => {
        console.log(`AlphaReview - ${self.dbName} init.`);
        self.db = event.target.result;
        resolve(self.db);
      };
      request.onupgradeneeded = (event) => {
        self.db = event.target.result;
        self.storeTypes.forEach((storeType) => {
          if (!storeType) return;
          if (self.db.objectStoreNames.contains(storeType)) return;
          self.db.createObjectStore(storeType, { keyPath: 'id', autoIncrement: true });
        });
      };
    });
  },
  addData: function (store, data) {
    const self = this;
    if (!self.db) {
      console.error(`AlphaReview - ${self.dbName} not initialized`);
      return;
    }
    return new Promise((resolve, reject) => {
      const transaction = self.db.transaction(store, 'readwrite');
      const objectStore = transaction.objectStore(store);
      const request = objectStore.add({ timestamp: new Date().getTime(), ...data });
      request.onsuccess = (event) => {
        resolve(event.target.result);
      };
      request.onerror = (event) => {
        reject(event.target.error);
      };
    });
  },
  getDatas: function (store, filterFunc = (data) => true, limit = 100) {
    /**
     * example) filterFunc = (data) => { return 5 < data.id && data.id < 10 };
     */
    const self = this;
    if (!self.db) {
      console.error(`AlphaReview - ${self.dbName} not initialized`);
      return;
    }
    return new Promise((resolve, reject) => {
      const transaction = self.db.transaction([store], 'readonly');
      const objectStore = transaction.objectStore(store);
      const request = objectStore.openCursor(null, 'prev');
      const datas = [];
      request.onsuccess = function (event) {
        const cursor = event.target.result;

        if (cursor && datas.length < limit) {
          const data = cursor.value;
          const isTarget = filterFunc ? filterFunc(data) : true;
          if (isTarget) datas.push(data);
          cursor.continue();
        } else {
          resolve(datas);
        }
      };
      request.onerror = function (event) {
        reject(event.target.error);
      };
    });
  },
  putDatas: function (store, updatedDatas) {
    const self = this;
    if (!self.db) {
      console.error(`AlphaReview - ${self.dbName} not initialized`);
      return;
    }
    return new Promise((resolve, reject) => {
      const transaction = self.db.transaction(store, 'readwrite');
      const objectStore = transaction.objectStore(store);
      updatedDatas.forEach((updatedData) => {
        const request = objectStore.put(updatedData);
        request.onsuccess = (event) => {
          resolve(event.target.result);
        };
        request.onerror = (event) => {
          console.error('AlphaReview - Update error:', event.target.error);
          reject(event.target.error);
        };
      });
    });
  },
};
