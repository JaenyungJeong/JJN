    try {
      const response = await fetch(url, {
        method: 'POST',
        headers: headers,
        body: JSON.stringify(data),
      });
      console.log('AlphaReview - postData response:', response);
    } catch (error) {
      console.error('AlphaReview - postData error:', error);
    }
  },
  createData: async function (event, metaData = {}) {
    if (!event) return;

    const datetime = new Date();
    const data = {
      ...this.baseData,
      ...metaData,
      date: datetime.toISOString().split('T')[0],
      time: datetime.toTimeString().split(' ')[0],
      event: event,
    };
    await this._postData(data);

    const dbData = {
      session_id: this.baseData.session_id,
      member_id: this.baseData.member_id,
